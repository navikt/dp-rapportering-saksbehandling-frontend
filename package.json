{
  "name": "dp-rapportering-saksbehandling-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "react-router build",
    "dev": "cross-env react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint",
    "test": "pnpm run test:vitest",
    "prepare": "husky",
    "test:vitest": "vitest run",
    "pre-commit": "lint-staged && pnpm run typecheck",
    "test:playwright": "playwright test --trace on"
  },
  "dependencies": {
    "@grafana/faro-react": "^2.12.1",
    "@grafana/faro-web-sdk": "^2.12.1",
    "@grafana/faro-web-tracing": "^2.12.1",
    "@msw/data": "^1.1.8",
    "@navikt/aksel-icons": "^8.19.2",
    "@navikt/ds-css": "^8.19.2",
    "@navikt/ds-react": "^8.19.2",
    "@navikt/oasis": "^4.2.2",
    "@portabletext/react": "^8.0.1",
    "@react-router/fs-routes": "8.5.0",
    "@react-router/node": "8.5.0",
    "@react-router/serve": "8.5.0",
    "@sanity/client": "^8.9.0",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "groq": "^6.19.0",
    "isbot": "^5.2.2",
    "msw": "^3.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.0",
    "tiny-invariant": "^1.3.3",
    "tinyduration": "^3.4.1",
    "unleash-client": "^6.12.2",
    "usehooks-ts": "^3.1.1",
    "uuidv7": "^1.2.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@portabletext/types": "^4.0.2",
    "@react-router/dev": "8.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0",
      "bash -c tsc",
      "bash -c 'pnpm run lint'"
    ]
  }
}

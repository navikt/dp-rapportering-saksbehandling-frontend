{
  "name": "dp-rapportering-saksbehandling-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "react-router build",
    "dev": "cross-env react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint",
    "test": "pnpm run test:vitest",
    "prepare": "husky",
    "test:vitest": "vitest run",
    "pre-commit": "lint-staged && pnpm run typecheck",
    "test:playwright": "playwright test --trace on"
  },
  "dependencies": {
    "@grafana/faro-react": "^2.9.0",
    "@grafana/faro-web-sdk": "^2.9.0",
    "@grafana/faro-web-tracing": "^2.9.0",
    "@msw/data": "^1.1.7",
    "@navikt/aksel-icons": "^8.16.1",
    "@navikt/ds-css": "^8.16.1",
    "@navikt/ds-react": "^8.16.1",
    "@navikt/oasis": "^4.1.4",
    "@portabletext/react": "^7.0.1",
    "@react-router/fs-routes": "^7.18.2",
    "@react-router/node": "^7.18.2",
    "@react-router/serve": "^7.18.2",
    "@sanity/client": "^7.26.2",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "groq": "^6.9.2",
    "isbot": "^5.2.1",
    "msw": "^2.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "tiny-invariant": "^1.3.3",
    "tinyduration": "^3.4.1",
    "usehooks-ts": "^3.1.1",
    "uuidv7": "^1.2.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@portabletext/types": "^4.0.2",
    "@react-router/dev": "^7.18.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-router-dom": "^5.3.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.10.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=25",
    "pnpm": ">=10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0",
      "bash -c tsc",
      "bash -c 'pnpm run lint'"
    ]
  }
}

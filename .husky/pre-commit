#!/usr/bin/env sh
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if [ -d "$HOME/.nvm/versions/node" ]; then
	for dir in "$HOME/.nvm/versions/node"/*/bin; do
		if [ -d "$dir" ]; then
			PATH="$dir:$PATH"
		fi
	done
fi

for dir in "$HOME/Library/pnpm" "$HOME/Library/pnpm/bin" "$HOME/Library/pnpm/.tools/pnpm"/*/bin; do
	if [ -d "$dir" ]; then
		PATH="$dir:$PATH"
	fi
done

export PATH

if ! command -v pnpm >/dev/null 2>&1; then
	echo "pnpm not found in PATH=$PATH" >&2
	exit 127
fi

pnpm run pre-commit
pnpm test

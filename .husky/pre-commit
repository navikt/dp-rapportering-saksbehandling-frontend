#!/usr/bin/env sh
set -e

if command -v corepack >/dev/null 2>&1; then
	PNPM_VERSION=$(sed -n 's/.*"packageManager":[[:space:]]*"pnpm@\([^"]*\)".*/\1/p' package.json | head -n 1)

	if [ -n "$PNPM_VERSION" ]; then
		corepack "pnpm@$PNPM_VERSION" exec lint-staged
		corepack "pnpm@$PNPM_VERSION" run typecheck
		corepack "pnpm@$PNPM_VERSION" run test:vitest
	else
		corepack pnpm exec lint-staged
		corepack pnpm run typecheck
		corepack pnpm run test:vitest
	fi
elif command -v pnpm >/dev/null 2>&1; then
	pnpm exec lint-staged
	pnpm run typecheck
	pnpm run test:vitest
else
	echo "Neither corepack nor pnpm is available in PATH." >&2
	echo "Install Node.js with Corepack enabled (or install pnpm) and retry." >&2
	exit 127
fi
